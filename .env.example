# Client feature flag (safe to expose)
VITE_ENABLE_PHO_TEST_CONTROLLER=true

# Server feature flag (Vercel Functions / Vite API middleware)
ENABLE_PHO_TEST_CONTROLLER=true

# Bearer secret for POST /api/test-call/command — never use a VITE_ prefix
TEST_CONTROLLER_SECRET=replace-me-with-a-long-random-secret

# Upstash Redis (Vercel Marketplace integration)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Use in-memory store for local/dev/e2e (set false when Redis is configured)
PHO_TEST_USE_MEMORY_STORE=true
